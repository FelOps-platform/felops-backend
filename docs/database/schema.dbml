// Tables
Table users {
  id int [pk, increment]
  name varchar(50) [not null]
  email varchar(255) [unique, not null] // stored lowercase
  password_hash varchar(255) [not null]
  is_verified boolean [not null, default: false]
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// Refresh tokens are stored as hashes, rotated on each refresh, and carry their session ID in the cookie.
Table sessions {
  id varchar(36) [pk]
  user_id int [not null]
  refresh_token_hash varchar(64) [unique, not null]
  expires_at datetime [not null]
  last_used_at datetime
  revoked_at datetime
  user_agent varchar(512)
  created_at datetime [default: `now()`]

  indexes {
    (user_id) [name: 'idx_sessions_user']
    (expires_at) [name: 'idx_sessions_expiry']
  }
}

// Email-verification and password-reset codes are hashed, expiring, and single-use.
Table auth_codes {
  id int [pk, increment]
  user_id int [not null]
  purpose auth_code_purpose [not null]
  code_hash varchar(64) [not null]
  expires_at datetime [not null]
  attempts int [not null, default: 0]
  consumed_at datetime
  created_at datetime [default: `now()`]

  indexes {
    (user_id, purpose, created_at) [name: 'idx_auth_codes_user_purpose']
    (expires_at) [name: 'idx_auth_codes_expiry']
  }
}

Table workspaces {
  id int [pk, increment]
  name varchar(50) [not null]
  owner_id int [not null, ref: > users.id]
  created_at datetime [default: `now()`]
}

Table agents {
  id int [pk, increment]
  workspace_id int [not null]
  name varchar(50) [not null]
  instructions varchar(8000) [not null]
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]

  indexes {
    (workspace_id, name) [unique]
  }
}

Table agents_actions {
  agent_id int [not null]
  tool_key varchar(100) [not null]
  requires_approval bool [not null, default: false]

  indexes {
    (agent_id, tool_key) [pk]
  }
}

// If the setting record for a workspace and tool key does not exist, the default is enabled.
Table workspace_action_settings {
  workspace_id int [not null]
  tool_key varchar(100) [not null]
  enabled bool [not null, default: true]
  updated_by int [ref: > users.id]
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]

  indexes {
    (workspace_id, tool_key) [pk]
  }
}

Table workspaces_channels {
  id int [pk, increment]
  workspace_id int [not null]
  channel_type channel_type [not null]
  name varchar(100) [not null]
  agent_id int // single agent per channel. nullable, a channel may be created without an agent assigned yet or the agent may be removed later.
  config jsonb [not null, default: '{}'] // channel-specific configuration (e.g., WhatsApp phone number)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]

  indexes {
    // channel instance names must be unique within a workspace
    (workspace_id, name) [unique, name: 'uq_channels_workspace_name']
  }
}

Table workspaces_integrations {
  workspace_id int [not null]
  integration_key varchar(50) [not null] // stable key from the code registry
  external_account_id varchar(255) [not null] // provider account identifier
  external_account_name varchar(255) // provider account display name
  granted_scopes varchar(1000)
  encrypted_credentials text [not null] // OAuth access and refresh tokens
  token_expires_at datetime
  connected_by int [not null, ref: > users.id]
  connected_at datetime [default: `now()`]
  last_validated_at datetime
  status integration_connection_status [not null, default: 'connected']

  indexes {
    (workspace_id, integration_key) [pk]
    (integration_key) [name: 'idx_wi_integration']
  }
}

Table oauth_states {
  state_hash varchar(64) [pk] // hashed one-time state, not the raw value
  workspace_id int [not null]
  integration_key varchar(50) [not null]
  initiated_by int [not null, ref: > users.id]
  redirect_uri varchar(2048) [not null] // backend callback URL
  return_path varchar(512)
  expires_at datetime [not null]
  consumed_at datetime
  created_at datetime [default: `now()`]

  indexes {
    (workspace_id, integration_key) [name: 'idx_oauth_state_workspace']
    (expires_at) [name: 'idx_oauth_state_expiry']
  }
}

// Basic shape; the conversation lane owns the full model
Table conversations {
  id int [pk, increment]
  workspace_id int [not null]
  agent_id int [not null]
  channel_id int [not null]
  created_at datetime [default: `now()`]

  indexes {
    (workspace_id, created_at) [name: 'idx_conversations_workspace_created']
  }
}

// Conversation history used by the Backend for frontend history.
// AI Service LangGraph checkpoints are separate and live in the AI Service.
Table messages {
  id int [pk, increment]
  conversation_id int [not null]
  sender_type message_sender_type [not null] // user | agent
  content text [not null]
  created_at datetime [default: `now()`]
  // we don't store the user id here because we don't have a users table for the end-users of the channels.

  indexes {
    (conversation_id, created_at) [name: 'idx_messages_conversation_created']
  }
}

// Executions
Table executions {
  id int [pk, increment]
  workspace_id int [not null]
  agent_id int [not null]
  conversation_id int [not null]
  integration_key varchar(50) [not null] // stable integration key
  tool_key varchar(100) [not null] // stable built-in tool key
  tool_arguments jsonb [not null, default: '{}']
  idempotency_key varchar(255) [not null]
  status execution_status [not null, default: 'running']
  result jsonb
  error_code varchar(64)
  error_message varchar(1000)
  retryable bool
  created_at datetime [default: `now()`]
  finished_at datetime

  indexes {
    (workspace_id, created_at) [name: 'idx_executions_workspace_created']
    (agent_id, created_at) [name: 'idx_executions_agent_created']
    (workspace_id, idempotency_key) [unique, name: 'uq_executions_workspace_idempotency']
  }
}

Table approvals {
  id varchar(36) [pk] // AI-generated UUID
  workspace_id int [not null]
  agent_id int [not null]
  conversation_id int [not null]
  job_id varchar(64) [not null]
  tool_key varchar(100) [not null]
  integration_key varchar(50) [not null]
  params jsonb [not null, default: '{}']
  effect_summary varchar(1000) [not null]
  status approval_status [not null, default: 'pending']
  decided_by int [ref: > users.id]
  note varchar(1000)
  requested_at datetime [default: `now()`]
  decided_at datetime

  indexes {
    (workspace_id, status) [name: 'idx_approvals_workspace_status']
    (agent_id, status) [name: 'idx_approvals_agent_status']
  }
}

// Workspace-wide knowledge sources. Agents select from this workspace library.
Table knowledge_sources {
  id int [pk, increment]
  workspace_id int [not null]
  source_type knowledge_source_type [not null]      // file | url
  content_hash varchar(64) [not null]               // normalized URL or file hash
  name varchar(255) [not null]
  description varchar(1000)
  url varchar(2048)
  file_type varchar(20)                             // txt | pdf | docx
  storage_key varchar(255)
  storage_content_type varchar(100)
  status knowledge_status [not null, default: 'processing']
  error_message varchar(1000)
  created_by int [ref: > users.id]
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]

  indexes {
    (workspace_id, content_hash) [unique, name: 'uq_knowledge_workspace_hash']
    (workspace_id, status) [name: 'idx_knowledge_workspace_status']
  }
}

// Backend validates that the agent and source belong to the same workspace before insert.
Table agents_knowledge_sources {
  agent_id int [not null]
  source_id int [not null]
  created_at datetime [default: `now()`]

  indexes {
    (agent_id, source_id) [pk]
    (source_id) [name: 'idx_agents_knowledge_source']
  }
}

// Relationships
Ref: sessions.user_id > users.id [delete: cascade]
Ref: auth_codes.user_id > users.id [delete: cascade]
Ref: agents.workspace_id > workspaces.id [delete: cascade]
Ref: workspace_action_settings.workspace_id > workspaces.id [delete: cascade]
Ref: workspaces_integrations.workspace_id > workspaces.id [delete: cascade]
Ref: oauth_states.workspace_id > workspaces.id [delete: cascade]
Ref: conversations.workspace_id > workspaces.id [delete: cascade]
Ref: executions.workspace_id > workspaces.id [delete: cascade]
Ref: approvals.workspace_id > workspaces.id [delete: cascade]
Ref: agents_actions.agent_id > agents.id [delete: cascade]
Ref: workspaces_channels.workspace_id > workspaces.id [delete: cascade]
Ref: workspaces_channels.agent_id > agents.id [delete: set null]
Ref: conversations.agent_id > agents.id [delete: cascade]
Ref: conversations.channel_id > workspaces_channels.id [delete: cascade]
Ref: executions.agent_id > agents.id [delete: cascade]
Ref: executions.conversation_id > conversations.id [delete: cascade]
Ref: approvals.agent_id > agents.id [delete: cascade]
Ref: approvals.conversation_id > conversations.id [delete: cascade]
Ref: knowledge_sources.workspace_id > workspaces.id [delete: cascade]
Ref: agents_knowledge_sources.agent_id > agents.id [delete: cascade]
Ref: agents_knowledge_sources.source_id > knowledge_sources.id [delete: cascade]
Ref: messages.conversation_id > conversations.id [delete: cascade]

// Enums
Enum message_sender_type {
  user
  agent
}

Enum execution_status {
  running
  succeeded
  failed
}

Enum approval_status {
  pending
  approved
  rejected
}

Enum knowledge_source_type {
  file
  url
}

Enum knowledge_status {
  processing
  ready
  failed
}

Enum integration_connection_status {
  connected
  invalid
}

Enum channel_type {
  whatsapp
  widget
  hosted
}

Enum auth_code_purpose {
  email_verification
  password_reset
}
