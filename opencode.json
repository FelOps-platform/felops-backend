{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "*database:migrate*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*drizzle-kit *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*supabase *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git merge *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh pr merge *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "npm publish *",
      "effect": "ask"
    }
  ]
}
