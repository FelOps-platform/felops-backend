{
  "felops-safety": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/safety-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "felops-doc-reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/doc-reminder.mjs",
        "timeout": 15
      }
    ]
  }
}
